# Copier ce fichier en « .env » (à la racine du dépôt) puis renseigner la clé.
# Le fichier .env est ignoré par Git : la clé ne sera jamais publiée.
ANTHROPIC_API_KEY=

# Facultatif : modèle et niveau de réflexion (low, medium, high)
# AUDIT_ERGO_MODELE=claude-opus-5-5
# AUDIT_ERGO_EFFORT=medium
# Mettre à 0 si l'API refuse le paramètre « fallbacks » (relance automatique en cas de refus)
# AUDIT_ERGO_FALLBACK=1
