# Fichier facultatif : copier en « .env » (à la racine du dépôt) pour imposer des réglages.
# Le fichier .env est ignoré par Git : la clé ne sera jamais publiée.

# --- Connexion au modèle -------------------------------------------------------------------------------
# Elle se règle normalement dans l'application, écran Réglages (adresse, clé chiffrée, certificat .crt,
# modèle, délai). Une variable renseignée ici est PRIORITAIRE sur l'écran, champ par champ, et n'y est plus
# modifiable : utile pour déployer les mêmes réglages sur plusieurs postes. Sans rien : Ollama sur ce poste.
# Enlever le « # » en tête de ligne pour imposer une valeur.

# Adresse du serveur du modèle (API compatible OpenAI, /v1/chat/completions)
#   ex. Ollama : http://localhost:11434/v1   LM Studio : http://localhost:1234/v1
# API_BASE=http://localhost:11434/v1

# Clé d'API exigée par le serveur (Ollama n'en demande pas)
# API_KEY=

# Fichier de certificats (PEM) de l'autorité qui a signé le certificat HTTPS du serveur.
# Sert aussi à installer les dépendances derrière un proxy d'entreprise (start.bat).
# CA_BUNDLE=

# Nom du modèle sur ce serveur (Ollama : « ollama list ») et délai maximal d'une réponse, en secondes
# AUDIT_ERGO_MODELE=mistral-small
# AUDIT_ERGO_DELAI=600

# --- Préférences --------------------------------------------------------------------------------------

# Langue par défaut de l'interface, des annotations et des textes de l'IA : fr ou en
AUDIT_ERGO_LANGUE=fr

# Facultatif : enlever le « # » en tête de ligne pour activer un réglage
#
# Température : basse = réponses stables d'un designer à l'autre
# AUDIT_ERGO_TEMPERATURE=0.2
# Longueur maximale d'une réponse
# AUDIT_ERGO_MAX_TOKENS=4000
# Constats analysés en même temps (1 conseillé pour un modèle local)
# AUDIT_ERGO_PARALLELE=1
# Emplacement du cache des réponses (défaut : .cache/suggestions.sqlite) ; 0 = désactivé
# AUDIT_ERGO_CACHE=
# Historique des audits : .donnees/audits par défaut ; un autre dossier, ou 0 pour ne rien enregistrer
# AUDIT_ERGO_HISTORIQUE=
# 0 désactive l'IA : seuls les contrôles de forme restent
# AUDIT_ERGO_IA=0
