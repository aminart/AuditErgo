# Copier ce fichier en « .env » (à la racine du dépôt) puis le compléter.
# Le fichier .env est ignoré par Git : la clé ne sera jamais publiée.

# Clé d'API (obligatoire pour les suggestions de critères)
API_KEY=

# Adresse de la passerelle. Les deux formes sont acceptées :
#   https://passerelle.exemple.fr/v1   ou   https://passerelle.exemple.fr/v1/chat/completions
# Laisser vide pour appeler directement l'API Anthropic.
API_BASE=

# Chemin du fichier de certificats (format PEM) de votre organisation, si la passerelle ou le proxy
# utilise une autorité de certification interne. Laisser vide sinon.
CA_BUNDLE=

# Nom du modèle tel que la passerelle le connaît (à demander à l'équipe qui gère la passerelle)
AUDIT_ERGO_MODELE=claude-opus-5-5

# Facultatif
# API_FORMAT=openai             # openai (/v1/chat/completions) ou anthropic (/v1/messages) ;
#                               # par défaut : openai si API_BASE est renseigné, anthropic sinon
# AUDIT_ERGO_MAX_TOKENS=16000   # à baisser si la passerelle refuse une valeur aussi élevée
# AUDIT_ERGO_EFFORT=medium      # format anthropic uniquement : low, medium, high
# AUDIT_ERGO_FALLBACK=1         # format anthropic uniquement : 0 pour désactiver la relance en cas de refus
# AUDIT_ERGO_CACHE=             # emplacement du cache des réponses (défaut : .cache/suggestions.sqlite) ; 0 = désactivé
