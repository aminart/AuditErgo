# Copier ce fichier en « .env » (à la racine du dépôt) puis le compléter.
# Le fichier .env est ignoré par Git : la clé ne sera jamais publiée.

# Clé d'API (obligatoire pour les suggestions de critères)
API_KEY=

# Adresse de l'API. Laisser vide pour l'API Anthropic (https://api.anthropic.com).
# À renseigner si les appels passent par une passerelle d'entreprise compatible avec l'API Anthropic.
API_BASE=

# Chemin du fichier de certificats (format PEM) de votre organisation, si la passerelle ou le proxy
# utilise une autorité de certification interne. Laisser vide sinon.
CA_BUNDLE=

# Facultatif : modèle et niveau de réflexion (low, medium, high)
# AUDIT_ERGO_MODELE=claude-opus-5-5
# AUDIT_ERGO_EFFORT=medium
# Mettre à 0 si l'API ou la passerelle refuse le paramètre « fallbacks » (relance automatique en cas de refus)
# AUDIT_ERGO_FALLBACK=1
