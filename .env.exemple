# Copier ce fichier en « .env » (à la racine du dépôt) puis l'adapter si besoin.
# Aucune donnée ne quitte le poste : l'IA est un modèle Mistral installé localement (Ollama ou LM Studio).

# Adresse du serveur du modèle local (compatible OpenAI, /v1/chat/completions)
#   Ollama    : http://localhost:11434/v1   (valeur par défaut)
#   LM Studio : http://localhost:1234/v1
API_BASE=http://localhost:11434/v1

# Nom du modèle sur ce serveur (Ollama : « ollama list » affiche les modèles installés)
AUDIT_ERGO_MODELE=mistral-small

# Langue par défaut de l'interface, des annotations et des textes de l'IA : fr ou en
AUDIT_ERGO_LANGUE=fr

# Facultatif
# API_KEY=                      # inutile avec Ollama ; à renseigner si le serveur local l'exige
# CA_BUNDLE=                    # certificats (PEM) : sert à l'installation des dépendances derrière un proxy
#                               # d'entreprise, et à un éventuel serveur interne en HTTPS
# AUDIT_ERGO_TEMPERATURE=0.2    # basse = réponses stables d'un designer à l'autre
# AUDIT_ERGO_MAX_TOKENS=4000    # longueur maximale d'une réponse
# AUDIT_ERGO_DELAI=600          # secondes avant d'abandonner une réponse (modèle lent sur CPU)
# AUDIT_ERGO_PARALLELE=1        # constats analysés en même temps (1 conseillé pour un modèle local)
# AUDIT_ERGO_CACHE=             # emplacement du cache des réponses (défaut : .cache/suggestions.sqlite) ; 0 = désactivé
# AUDIT_ERGO_IA=0               # désactive l'IA : seuls les contrôles de forme restent
# AUDIT_ERGO_RESEAU_AUTORISE=1  # À NE METTRE QUE pour un serveur interne validé par l'organisation :
#                               # autorise une adresse API_BASE qui n'est pas sur ce poste
